---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const shareImage = new URL("/images/meta/og-image.png", Astro.site).toString();

const defaultSeo: AstroSeoProps = {
	title: "caleb.rocks — Fast, Modern Websites for Regional Queensland Businesses",
	description:
		"I design and build fast, modern, low-maintenance websites for established regional Australian businesses — builders, mechanics, earthmoving, quarries and trades. Based on the Granite Belt, QLD.",
	canonical: "https://caleb.rocks/",
	openGraph: {
		url: "https://caleb.rocks/",
		title: "caleb.rocks — Fast, Modern Websites for Regional Queensland Businesses",
		description:
			"Fast, professional, low-maintenance websites for regional businesses — designed, built and supported by Caleb on the Granite Belt.",
		images: [
			{
				url: shareImage,
				width: 1200,
				height: 630,
				alt: "caleb.rocks — fast, modern websites for regional businesses",
				type: "image/png",
			},
		],
		site_name: "caleb.rocks",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "caleb.rocks",
		},
	],
};

const seo = {
	...defaultSeo,
	...seoProp,
};

function cursorFollowerActive() {
	const paths = ["", "/"];
	return paths.includes(pathname);
}
---

<html lang={lang}>
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
	</head>
	<body class="bg-slate-50">
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower />}
		<slot />
		<Footer />
	</body>
</html>
