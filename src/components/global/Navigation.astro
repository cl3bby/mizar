---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const isDev = import.meta.env.DEV;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

let pages = [
	{
		title: "Home",
		url: "/",
	},
	// {
	// 	title: "Services",
	// 	url: "/services",
	// },
	{
		title: "Blog",
		url: "/blog/",
	},
	{
		title: t("contacts"),
		url: "/contact/",
	},
];

// if (isDev) {
// 	pages.push({
// 		title: "Overview",
// 		url: "/system/overview",
// 	});
// }

const { pathname } = Astro.url;
---

<header>
	<a href={translatePath("/")} aria-label="Home" class="logo absolute z-50 flex h-[4.5rem] items-center md:h-[5.9rem]">
		<img src="/logo-dark.svg" alt="caleb.rocks" class="logo-svg h-7 w-auto md:h-12" />
	</a>
	<div data-xdata="{ open: false }" class="navigation fixed right-0 top-0 z-50 md:w-auto" data-xbind.class="{'w-full navbar-open': open}">
		<div class="ml-auto md:max-w-sm" data-xbind.class="{'max-w-3xl': open, 'max-w-[8rem]': !open }">
			<div class="mx-auto w-full">
				<div
					class="shadow-thick nav-container squircle relative mx-auto flex w-full flex-col justify-center overflow-x-hidden bg-brand-dark ring-1 ring-brand-light/10 backdrop-blur-xl backdrop-filter">
					<div class="flex flex-row items-center justify-end">
						<a class="px-3 py-[0.4rem] pl-4" href={translatePath("/contact/")} aria-label="Contact Page">
							<Icon class="text-brand-light" name="octicon:mail-16" width="20" data-xbind.class="{'hidden': open}" />
						</a>
						<button
							data-xon.click="open = !open"
							data-xbind.style="{'padding-top': open ? '1rem' : '0.4rem'}"
							data-xbind.aria-expanded="open"
							aria-controls="site-menu"
							aria-label="Toggle menu"
							class="inline-flex items-center justify-center px-3 py-[0.4rem] pr-4 text-brand-light hover:text-brand-accent focus:text-brand-light focus:outline-none">
							<svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
								<path
									data-xbind.class="{'hidden': open, 'inline-flex': !open }"
									class="inline-flex"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M4 6h16M4 12h16M4 18h16">
								</path>
								<path
									data-xbind.class="{'hidden': !open, 'inline-flex': open }"
									class="hidden"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M6 18L18 6M6 6l12 12">
								</path>
							</svg>
						</button>
					</div>
					<nav id="site-menu" data-xbind.class="{'flex': open, 'hidden': !open}" class="hidden flex-grow flex-col justify-center py-12">
						<ul class="flex list-none flex-col items-end justify-center gap-2 px-2 text-center text-3xl">
							{
								pages.map((page) => (
									<li data-cursor-hover>
										<a
											href={translatePath(page.url)}
											class={`inline-block cursor-pointer px-1 py-[0.33rem] ${
												page.url === pathname || (page.url === "/blog" && pathname.startsWith("/blog")) ? "active" : ""
											}`}>
											<span class="menu-item-container inline-block">
												<span class="menu-item px-4 py-1 font-semibold uppercase tracking-wide text-brand-light/70 hover:text-brand-light focus:text-brand-light focus:shadow-none focus:outline-none">
													{page.title}
												</span>
											</span>
										</a>
									</li>
								))
							}
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	.navigation,
	.logo {
		padding: 1rem var(--base-padding-x);
	}
	@media (min-width: 768px) {
		.navigation,
		.logo {
			padding: 2rem var(--base-padding-x);
		}
		.navigation.navbar-open > div {
			width: 20rem;
		}
	}
	nav a .menu-item-container {
		border-radius: 0.45rem;
	}
	nav a.active .menu-item-container,
	nav a:hover .menu-item-container {
		transition: background-color 0.3s ease;
	}
	nav a.active .menu-item-container {
		background: #bd8d43;
	}
	nav a:hover .menu-item-container {
		background: #d8e4de;
	}
	nav a.active .menu-item-container .menu-item,
	nav a:hover .menu-item-container .menu-item {
		color: #153834;
	}
</style>
