---
import "../styles/global.css";
---

<meta name="viewport" content="width=device-width" />
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="author" content="Caleb Bruce Whittaker" />
<meta name="keywords" content="web design, web development, regional Queensland, Granite Belt, caleb.rocks" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="64x64" href="/pwa-64x64.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/pwa-192x192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/pwa-512x512.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="mask-icon" href="/maskable-icon.png" color="#153834" />
<meta name="msapplication-TileColor" content="#153834" />
<meta name="theme-color" content="#153834" />

<link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

<!-- Scripts -->
<script defer src="/js/alpine.min.js"></script>

<script is:inline>
	const startingWith =
		(subject, replacement) =>
		({ name, value }) => {
			if (name.startsWith(subject)) {
				name = name.replace(subject, replacement);
			}
			return { name, value };
		};

	document.addEventListener("alpine:init", () => {
		Alpine.prefix("data-x");
		Alpine.mapAttributes(startingWith("data-xon.", Alpine.prefixed("on:")));
		Alpine.mapAttributes(startingWith("data-xbind.", Alpine.prefixed("bind:")));
	});
</script>

<script is:inline>
	if ("paintWorklet" in CSS) {
		CSS.paintWorklet.addModule("/js/squircle.min.js");
	}
</script>
