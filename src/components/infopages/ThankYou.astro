---
import Title from "../global/Title.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="isolate px-6 py-24 sm:py-32 lg:px-8">
	<div class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
		<div class="text-center">
			<div class:list={["flex justify-center pb-10 pt-20 uppercase"]}>
				<div class="inline-flex flex-col gap-4">
					<div class="inline-flex items-center justify-center gap-4">
						<span class="font-mono text-xs font-semibold uppercase tracking-wide">{t("thanks.subtitle")}</span>
					</div>
					<h1 class="font-display text-3xl font-extrabold sm:text-4xl md:text-5xl lg:text-6xl">{t("thanks.title")}</h1>
				</div>
			</div>

			<p class="mt-6 text-base leading-7 text-brand-dark/70">{t("thanks.content")}</p>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				<div class="squircle-bg rounded-lg bg-brand-dark">
					<a
						class="flex h-10 w-full max-w-52 flex-1 items-center justify-center px-4 py-2 text-xl text-brand-light transition-all hover:text-brand-accent sm:w-auto md:font-bold lg:h-10"
						href={translatePath("/")}>
						{t("homepage")}
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
</style>
