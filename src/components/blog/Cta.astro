---
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="bg-black">
	<div class="mx-auto max-w-7xl px-8 py-12 md:px-12 lg:px-32 lg:py-24">
		<div class="flex flex-col items-center justify-center gap-10 p-8 text-center lg:p-20">
			<p class="mt-8 font-display text-4xl font-semibold text-white md:text-6xl lg:text-8xl">
				Have a project in mind?
			</p>
			<a
				class="flex h-12 items-center justify-center rounded-full bg-lime-500 px-8 text-lg font-semibold text-black transition-colors hover:bg-lime-400 lg:h-16"
				href={translatePath("/contact/")}>
				{t("contactus")} &nbsp; →
			</a>
		</div>
	</div>
</section>
