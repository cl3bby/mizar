---
import Contact from "@/components/forms/Contact.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Contact — caleb.rocks",
	description: "Tell me about your business and what you need. Free, no-obligation chat about a new or replacement website.",
	canonical: "https://caleb.rocks/contact/",
};
---

<BaseLayout seo={seo}>
	<Contact />
</BaseLayout>
