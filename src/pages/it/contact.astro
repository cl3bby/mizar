---
import Contact from "@/components/forms/Contact.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Contatti — caleb.rocks",
	description: "Raccontami della tua attività e di cosa hai bisogno. Un confronto gratuito e senza impegno.",
	canonical: "https://caleb.rocks/it/contact/",
};
---

<BaseLayout seo={seo}>
	<Contact />
</BaseLayout>
